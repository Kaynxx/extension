{
  "name": "webgpu-video-upscaler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first WebGPU video upscaler Chrome extension",
  "scripts": {
    "build": "npm run build:content && npm run build:popup && npm run build:background",
    "build:content": "vite build --mode content",
    "build:popup": "vite build --mode popup",
    "build:background": "vite build --mode background",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "playwright test",
    "test:p1-benchmark": "node scripts/run-p1-benchmark.mjs",
    "test:p1-adaptive": "node scripts/run-p1-adaptive-evidence.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "test:p1-visual": "node scripts/run-p1-visual-evidence.mjs",
    "test:p2-p3": "node scripts/run-p2-p3-evidence.mjs",
    "test:p1-visual-manifest": "node scripts/promote-p1-visual-archive.mjs",
    "test:acceptance-plan": "node scripts/acceptance-validation.mjs --plan",
    "test:acceptance-manifest": "node scripts/acceptance-validation.mjs --validate-manifest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "26.5.1",
    "@vitest/expect": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
